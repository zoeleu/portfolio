# Files in /assets/ have a content hash in their name, so a changed file gets a
# new URL. Browsers can keep them for a year without checking back.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages may be reused for a minute without asking the server, so a page the
# hover preloader fetched (preload.js, for Safari and Firefox) opens at once.
# The trade-off: for up to a minute after a deploy, a visitor can get an older
# page. Listed by path, not /*, which would also match /assets/* above and
# have its Cache-Control joined to that rule's with a comma.
/
  Cache-Control: public, max-age=60

/blog/*
  Cache-Control: public, max-age=60

/projects/*
  Cache-Control: public, max-age=60

/contact/*
  Cache-Control: public, max-age=60
